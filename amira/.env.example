# amira/.env.example
# Copy this file to amira/.env and fill in real values.
# NEVER commit amira/.env to version control.

# ── AMIRA service settings ────────────────────────────────────────────────
# Log level for the uvicorn process
LOG_LEVEL=INFO

# Default trading capital for the Risk Officer (in user base currency)
AMIRA_CAPITAL=3000.0

# Maximum % of capital risked per trade (Risk Officer guardrail)
AMIRA_RISK_PCT=2.0

# ── Optional external data sources ───────────────────────────────────────
# (currently unused — yfinance is unauthenticated)
# ALPHA_VANTAGE_API_KEY=

# ── Internal service URL (set in aura-app's .env, NOT here) ───────────────
# aura-app reaches AMIRA at: http://amira-app:8000
# In AuraOne/.env set:  AMIRA_SERVICE_URL=http://amira-app:8000
