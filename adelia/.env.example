# ── ADELIA Microservice — Environment Variables (placeholders only) ─────
# Copy this to .env and fill in real values. NEVER commit .env itself.

# ── Hugging Face Inference API ─────────────────────────────────────────
HF_TOKEN=hf_your_token_here
USE_HF_INFERENCE=true
HF_EMBED_MODEL=BAAI/bge-m3
HF_ZEROSHOT_MODEL=facebook/bart-large-mnli
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=hf-inference
HF_TIMEOUT=60
