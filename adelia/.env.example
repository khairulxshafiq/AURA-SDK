# ─────────────────────────────────────────────────────────────
# ADELIA Microservice — Environment Configuration Template
# ─────────────────────────────────────────────────────────────

# ── Gemini API Keys & Settings ───────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=optional_backup_gemini_key_1
GEMINI_API_KEY_2=optional_backup_gemini_key_2
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=6
GEMINI_COOLDOWN=600

# ── OpenRouter Fallback ──────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash

# ── Hugging Face Serverless Inference ───────────────────────
HF_TOKEN=your_huggingface_token_here
HF_EMBED_MODEL=BAAI/bge-m3
HF_ZEROSHOT_MODEL=facebook/bart-large-mnli
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=hf-inference
USE_HF_INFERENCE=false

# ── Airtable Content Station Integration ────────────────────
AIRTABLE_API_KEY=your_airtable_pat_here
AIRTABLE_BASE_ID=app_your_base_id_here
AIRTABLE_TABLE_NAME=Content Station

# ── Google Drive API Folders & Credentials ──────────────────
GDRIVE_IMAGE_FOLDER_ID=1ntdhPOq3Z7oNXLDqQgVyVQS6tIMoArc3
GDRIVE_DUMP_FOLDER_ID=1Ybx7mBAKksI2VcagHAqOuKkf8pjbvYwa
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# ── Brand & Defaults ─────────────────────────────────────────
DEFAULT_BRAND=Sakluma
